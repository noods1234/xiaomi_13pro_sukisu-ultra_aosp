# HZ_1000 config fragment — used by enableHZ1000 workflow toggle
#
# CONFIG_HZ is a Kconfig `choice` block. Both the old selection and the new
# selection must be explicitly stated in a fragment so that merge_config.sh
# (scripts/kconfig/merge_config.sh) can resolve the choice cleanly.
# See: https://github.com/torvalds/linux/blob/master/scripts/kconfig/merge_config.sh
#
# WARNING: This overrides the GKI-locked CONFIG_HZ_300=y setting from
# arch/arm64/configs/gki_defconfig. The resulting image is NOT GKI ABI
# compliant. Tested subsystem regressions to watch: camera CRM timeouts,
# display SDE idle sequencing, video VIDC encode/decode, and suspend/resume.

# Deselect the GKI-default choice
# CONFIG_HZ_300 is not set

# Select HZ=1000
CONFIG_HZ_1000=y
