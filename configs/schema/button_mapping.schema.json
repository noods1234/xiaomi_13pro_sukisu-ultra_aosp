{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OIW-ROM Button Mapping",
  "type": "object",
  "required": ["id", "mappings"],
  "properties": {
    "id": { "type": "string" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input", "action"],
        "properties": {
          "input": {
            "type": "string",
            "enum": [
              "volume_up_short", "volume_down_short", "volume_up_long", "volume_down_long",
              "double_tap_preview", "two_finger_tap", "three_finger_tap",
              "power_short_while_recording", "power_long", "hid_key_r", "hid_key_space"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "record_toggle", "still_capture", "profile_cycle", "focus_assist_toggle",
              "overlay_toggle", "screen_lock", "emergency_stop", "lock_screen_only",
              "system_power_menu_with_warning", "none"
            ]
          }
        }
      }
    }
  }
}
